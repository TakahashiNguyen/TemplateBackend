{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"baseUrl": "../src",
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"module": "commonjs",
		"resolveJsonModule": true,
		"rootDirs": [
			"..",
			"."
		],
		"strict": true,
		"target": "esnext",
		"paths": {
			"*": ["./node_modules", "../src"]
		}
	},
	"include": [
		"../src"
	]
}
