{
	"customizations": {
		"vscode": {
			"extensions": [
				"GitHub.vscode-pull-request-github",
				"dbaeumer.vscode-eslint",
				"PeterSchmalfeldt.explorer-exclude",
				"GraphQL.vscode-graphql-syntax",
				"NicholasHsiang.vscode-javascript-comment",
				"Orta.vscode-jest",
				"PKief.material-icon-theme",
				"esbenp.prettier-vscode",
				"vscodevim.vim",
				"bradlc.vscode-tailwindcss",
				"ecmel.vscode-html-css",
				"streetsidesoftware.code-spell-checker"
			]
		}
	},
	"features": {
		"ghcr.io/devcontainers-extra/features/redis-homebrew:1": {},
		"ghcr.io/devcontainers/features/git:1": {
			"ppa": "false",
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/node:1": {
			"nodeGypDependencies": false,
			"nvmVersion": "latest",
			"pnpmVersion": "latest",
			"version": "latest"
		},
		"ghcr.io/takahashinguyen/devcontainer-features/minio-client-homebrew:latest": {},
		"ghcr.io/takahashinguyen/devcontainer-features/minio-homebrew:latest": {}
	},
	"forwardPorts": [3000, 6379, 9000, 9001],
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu",
	"postAttachCommand": {
		"redis": "/home/linuxbrew/.linuxbrew/bin/redis-server --daemonize yes"
	},
	"postCreateCommand": {
		"mc": "sleep 5 && mc alias set local 'http://127.0.0.1:9000' 'admin' 'admin' && mc mb local/bucket",
		"pnpm": "pnpm install"
	},
	"runArgs": ["--add-host=host.docker.internal:host-gateway"]
}
