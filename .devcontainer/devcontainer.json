{
	"customizations": {
		"vscode": {
			"extensions": [
				"GitHub.vscode-pull-request-github",
				"dbaeumer.vscode-eslint",
				"PeterSchmalfeldt.explorer-exclude",
				"GraphQL.vscode-graphql-syntax",
				"NicholasHsiang.vscode-javascript-comment",
				"Orta.vscode-jest",
				"PKief.material-icon-theme",
				"esbenp.prettier-vscode",
				"vscodevim.vim",
				"bradlc.vscode-tailwindcss",
				"ecmel.vscode-html-css",
				"streetsidesoftware.code-spell-checker",
				"Vue.volar",
				"github.vscode-github-actions"
			]
		}
	},
	"dockerComposeFile": "docker-compose.yml",
	"forwardPorts": [3000, 6379, 9000, 9001, 8025, 5173],
	"postCreateCommand": {
		"mc": "sleep 5 && mc alias set local 'http://localhost:9000' 'minioadmin' 'minioadmin' && mc mb local/default",
		"pnpm": "pnpm install",
		"ssl": "openssl req -x509 -newkey rsa:4096 -nodes -keyout /key.pem -out /cert.pem -sha256 -days 3650 -subj \"/C=VN/ST=Hanoi/L=Hanoi/O=foo/CN=bar.com\""
	},
	"service": "devcontainer",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}"
}
