{
	"customizations": {
		"vscode": {
			"extensions": [
				"GitHub.vscode-pull-request-github",
				"dbaeumer.vscode-eslint",
				"PeterSchmalfeldt.explorer-exclude",
				"GraphQL.vscode-graphql-syntax",
				"NicholasHsiang.vscode-javascript-comment",
				"Orta.vscode-jest",
				"PKief.material-icon-theme",
				"esbenp.prettier-vscode",
				"vscodevim.vim",
				"bradlc.vscode-tailwindcss",
				"ecmel.vscode-html-css",
				"streetsidesoftware.code-spell-checker",
				"Vue.volar",
				"github.vscode-github-actions",
				"tauri-apps.tauri-vscode",
				"rust-lang.rust-analyzer",
				"tamasfe.even-better-toml"
			]
		}
	},
	"dockerComposeFile": "docker-compose.main.yml",
	"forwardPorts": [3000, 6379, 9000, 9001, 8025, 5173],
	"postCreateCommand": {
		"compile": "pnpm run build",
		"ssl": "openssl req -x509 -newkey rsa:4096 -nodes -keyout /certs/key.pem -out /certs/cert.pem -sha256 -days 3650 -subj \"/C=VN/ST=Hanoi/L=Hanoi/O=foo/CN=bar.com\""
	},
	"remoteEnv": {
		"ACCESS_SECRET": "${localEnv:ACCESS_SECRET}",
		"REFRESH_SECRET": "${localEnv:REFRESH_SECRET}",
		"SERVER_SECRET": "${localEnv:SERVER_SECRET}"
	},
	"service": "devcontainer",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}"
}
