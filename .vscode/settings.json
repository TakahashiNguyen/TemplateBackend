{
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.patterns": {
		"*.entity.ts": "$(capture).model.ts, $(capture).graphql.ts, $(capture).dto.ts",
		"*.ts": "$(capture).spec.ts",
		"package.json": "LICENSE*,*.md,nest-cli.json,.gitignore,.env*,.*rc,*.config.js,*.config.ts,*.config.json,*.config.mjs,*.config.cjs,*.config.yaml,*.config.yml",
		"tsconfig.json": "tsconfig.*.json"
	},
	"explorerExclude.backup": {},
	"files.exclude": {
		"**/.DS_Store": true,
		"**/.git": true,
		"**/.hg": true,
		"**/.svn": true,
		"**/Thumbs.db": true,
		"**/dist": true,
		"**/node_modules": true,
		"**/pnpm-lock.yaml": true,
		".pnpm-store": true,
		"docs": true
	},
	"postman.settings.dotenv-detection-notification-visibility": false,
	"todohighlight.keywords": [
		{
			"backgroundColor": "#FCBA04",
			"color": "#A50104",
			"isWholeLine": true,
			"text": "// Number.prototype"
		},
		{
			"backgroundColor": "#659157",
			"color": "#FFCAB1",
			"isWholeLine": true,
			"text": "// Array.prototype"
		},
		{
			"backgroundColor": "#B89685",
			"color": "#022B3A",
			"isWholeLine": true,
			"text": "// String.prototype"
		}
	]
}
