{
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.patterns": {
		"*.entity.ts": "$(capture).model.ts, $(capture).graphql.ts, $(capture).dto.ts",
		"*.ts": "$(capture).spec.ts",
		"package.json": "LICENSE*, *.md, nest-cli.json, .gitignore, .env*, .*rc",
		"tsconfig.json": "tsconfig.*.json"
	},
	"explorerExclude.backup": {},
	"files.exclude": {
		"**/.DS_Store": true,
		"**/.git": true,
		"**/.hg": true,
		"**/.svn": true,
		"**/Thumbs.db": true,
		"**/node_modules": true,
		"**/pnpm-lock.yaml": true
	}
}
