{
	"cSpell.words": [
		"apollographql",
		"codegen",
		"flowbite",
		"gqlg",
		"gstatic",
		"minioadmin",
		"pgadmin",
		"templatebackend",
		"trivago",
		"unsign",
		"vueuse",
		"xxhashjs"
	],
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.patterns": {
		"*.entity.ts": "$(capture).model.ts, $(capture).graphql.ts, $(capture).dto.ts",
		"*.guard.ts": "$(capture).strategy.ts",
		"*.ts": "$(capture).spec.ts, $(capture).spec.util.ts",
		"package.json": "LICENSE*,*.md,nest-cli.json,.gitignore,.env*,.*rc,*.config.js,*.config.ts,*.config.json,*.config.mjs,*.config.cjs,*.config.yaml,*.config.yml",
		"tsconfig.json": "tsconfig.*.json"
	},
	"explorerExclude.backup": {},
	"files.exclude": {
		"**/.DS_Store": true,
		"**/.git": true,
		"**/.hg": true,
		"**/.svn": true,
		"**/Thumbs.db": true,
		"**/dist": true,
		"**/node_modules": true,
		"**/pnpm-lock.yaml": true,
		".pnpm-store": true,
		".tsup": true,
		"docs": true
	},
	"jest.outputConfig": {
		"clearOnRun": "terminal"
	},
	"jest.runMode": {
		"coverage": true,
		"showInlineError": true,
		"type": "on-demand"
	},
	"testing.automaticallyOpenTestResults": "neverOpen",
	"todohighlight.keywords": [
		{
			"backgroundColor": "#E4D6A7",
			"color": "#1C110A",
			"isWholeLine": true,
			"text": "// Relationships"
		},
		{
			"backgroundColor": "#FCBA04",
			"color": "#A50104",
			"isWholeLine": true,
			"text": "// Number.prototype"
		},
		{
			"backgroundColor": "#659157",
			"color": "#FFCAB1",
			"isWholeLine": true,
			"text": "// Array.prototype"
		},
		{
			"backgroundColor": "#B89685",
			"color": "#022B3A",
			"isWholeLine": true,
			"text": "// String.prototype"
		},
		{
			"backgroundColor": "#ECB0E1",
			"color": "#A31621",
			"isWholeLine": true,
			"text": "// Interfaces"
		},
		{
			"backgroundColor": "#E94F37",
			"color": "#F6F7EB",
			"isWholeLine": true,
			"text": "// Enums"
		},
		{
			"backgroundColor": "#4464AD",
			"color": "#FFC759",
