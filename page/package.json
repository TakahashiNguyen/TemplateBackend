{
	"name": "page",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
		"dev:api": "cd .. && npm run start",
		"dev:web": "vite",
		"pretypes": "cd ../server && npm run types",
		"types": "pnpm add file:../server/types",
		"prebuild": "pnpm i && npm run types",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview"
	},
	"dependencies": {
		"@apollo/explorer": "^3.7.2",
		"@tailwindcss/vite": "^4.1.10",
		"@vueuse/core": "^13.5.0",
		"axios": "^1.10.0",
		"flowbite": "^3.1.2",
		"material-symbols": "^0.32.0",
		"tailwindcss": "^4.1.10",
		"templatebackend-types": "file:../server/types",
		"vue": "^3.5.13",
		"vue-router": "^4.5.1"
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "^5.2.3",
		"@vue/tsconfig": "^0.7.0",
		"concurrently": "^9.2.0",
		"rollup-plugin-visualizer": "^6.0.3",
		"typescript": "~5.8.3",
		"vite": "^6.3.5",
		"vite-plugin-externalize-deps": "^0.9.0",
		"vite-plugin-node-polyfills": "^0.24.0",
		"vue-tsc": "^2.2.8"
	}
}
