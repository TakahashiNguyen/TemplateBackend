{
	"name": "templatebackend",
	"version": "0.0.1",
	"description": "A NestJS backend template project.",
	"author": "Takahashi Nguyen <takahashi.nguyen@icloud.com>",
	"private": true,
	"license": "MIT",
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"scripts": {
		"commit": "cz",
		"prebuild": "npm run mail:build",
		"build": "nest build",
		"doc": "compodoc src -p tsconfig.doc.json --disableSourceCode --hideGenerator -d ./docs",
		"format": "prettier --write \"./**/*.css\" \"./**/*.ts\" \"./**/*.json\" \"./**/*.ts\" \"./**/*.html\" \"./**/*.vue\"",
		"mail:dev": "cd mail && npm run dev",
		"mail:build": "cd mail && npm run build && cd ..",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint ./src --fix",
		"types:build": "ts-node types/types.build.ts && tsup",
		"test": "jest --config=./test/jest.all.config.ts",
		"test:requesters": "jest --config=./test/jest.requesters.config.ts",
		"test:service": "jest --config=./test/jest.service.config.ts",
		"test:etc": "jest --config=./test/jest.etc.config.ts"
	},
	"dependencies": {
		"@apollo/server": "^4.12.2",
		"@apollo/server-plugin-response-cache": "^4.1.4",
		"@apollo/subgraph": "^2.11.0",
		"@as-integrations/fastify": "^2.1.1",
		"@aws-sdk/client-s3": "^3.837.0",
		"@aws-sdk/lib-storage": "^3.837.0",
		"@fastify/compress": "^8.0.3",
		"@fastify/csrf-protection": "^7.1.0",
		"@fastify/helmet": "^13.0.1",
		"@fastify/secure-session": "^8.2.0",
		"@fastify/static": "^8.2.0",
		"@keyv/redis": "^4.4.0",
		"@nestjs-modules/mailer": "^2.0.2",
		"@nestjs/apollo": "^13.1.0",
		"@nestjs/cache-manager": "^3.0.1",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.0.1",
		"@nestjs/graphql": "^13.1.0",
		"@nestjs/jwt": "^11.0.0",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-fastify": "^11.1.3",
		"@nestjs/schedule": "^6.0.0",
		"@nestjs/swagger": "^11.2.0",
		"@nestjs/terminus": "^11.0.0",
		"@nestjs/throttler": "^6.4.0",
		"@nestjs/typeorm": "^11.0.0",
		"@node-rs/argon2": "^2.0.2",
		"cacheable": "^1.10.2",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.2",
		"fastify-multer": "^2.0.3",
		"graphql": "^16.11.0",
		"graphql-upload-ts": "^2.1.2",
		"joi": "^17.13.3",
		"keyv": "^5.3.4",
		"mime-types": "^3.0.1",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"picocolors": "^1.1.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"typeorm": "^0.3.24",
		"ua-parser-js": "^2.0.4",
		"xxhashjs": "^0.2.2"
	},
	"devDependencies": {
		"@compodoc/compodoc": "^1.1.26",
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.29.0",
		"@eslint/json": "^0.12.0",
		"@eslint/markdown": "^6.5.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"@types/jest": "^29.5.14",
		"@types/mime-types": "^3.0.1",
		"@types/node": "^22.15.31",
		"@types/nodemailer": "^6.4.17",
		"@types/passport-jwt": "^4.0.1",
		"@types/supertest": "^6.0.2",
		"@types/ws": "^8.18.1",
		"@types/xxhashjs": "^0.2.4",
		"@vue/compiler-sfc": "^3.5.17",
		"commitizen": "^4.3.1",
