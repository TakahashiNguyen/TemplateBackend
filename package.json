{
	"name": "templatefullstack",
	"version": "0.0.0",
	"author": "Takahashi Nguyen <takahashi.nguyen@icloud.com>",
	"private": true,
	"description": "A full stack application",
	"license": "MIT",
	"scripts": {
		"commit": "cz",
		"lint": "pnpm run -r --if-present --parallel lint",
		"format": "prettier \"!**/*/debug\" --write \"./**/*.css\" \"./**/*.ts\" \"./**/*.json\" \"./**/*.ts\" \"./**/*.html\" \"./**/*.vue\"",
		"types": "cd types && npm run build",
		"prebuild": "pnpm i -r && npm run types",
		"build": "pnpm run -r --if-present --parallel --filter \"!./types\" build"
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"@vue/compiler-sfc": "^3.5.24",
		"prettier": "^3.5.3",
		"prettier-plugin-jsdoc": "^1.3.2",
		"prettier-plugin-sort-json": "^4.1.1",
		"commitizen": "^4.3.1",
		"cz-conventional-changelog": "^3.3.0",
		"prettier-plugin-tailwindcss": "^0.7.1"
	},
	"packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
