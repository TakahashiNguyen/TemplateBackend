{
	"name": "templatebackend",
	"version": "0.0.1",
	"description": "A NestJS backend template project.",
	"author": "Takahashi Nguyen <takahashi.nguyen@icloud.com>",
	"private": true,
	"license": "MIT",
	"scripts": {
		"build": "nest build",
		"doc": "compodoc src -p tsconfig.doc.json --disableSourceCode --hideGenerator -d ./docs",
		"format": "prettier --write \"./**/*.ts\" \"./**/*.json\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint ./src --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json"
	},
	"dependencies": {
		"@apollo/server": "^4.12.2",
		"@apollo/server-plugin-response-cache": "^4.1.4",
		"@fastify/compress": "^8.0.3",
		"@fastify/csrf-protection": "^7.1.0",
		"@fastify/helmet": "^13.0.1",
		"@fastify/secure-session": "^8.2.0",
		"@fastify/static": "^8.2.0",
		"@keyv/redis": "^4.4.0",
		"@nestjs/apollo": "^13.1.0",
		"@nestjs/cache-manager": "^3.0.1",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.0.1",
		"@nestjs/graphql": "^13.1.0",
		"@nestjs/jwt": "^11.0.0",
		"@nestjs/platform-fastify": "^11.1.3",
		"@nestjs/swagger": "^11.2.0",
		"@nestjs/typeorm": "^11.0.0",
		"argon2": "^0.43.0",
		"cacheable": "^1.10.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.2",
		"graphql": "^16.11.0",
		"joi": "^17.13.3",
		"keyv": "^5.3.4",
		"picocolors": "^1.1.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"typeorm": "^0.3.24",
		"xxhashjs": "^0.2.2"
	},
	"devDependencies": {
		"@compodoc/compodoc": "^1.1.26",
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.29.0",
		"@eslint/json": "^0.12.0",
		"@eslint/markdown": "^6.5.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@swc/cli": "^0.6.0",
		"@swc/core": "^1.10.7",
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.15.31",
		"@types/supertest": "^6.0.2",
		"@types/xxhashjs": "^0.2.4",
		"eslint": "^9.29.0",
		"eslint-plugin-jest": "^28.13.5",
		"eslint-plugin-jsdoc": "^51.2.2",
		"globals": "^16.2.0",
		"jest": "^29.7.0",
		"prettier": "^3.5.3",
		"prettier-plugin-jsdoc": "^1.3.2",
		"prettier-plugin-sort-json": "^4.1.1",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.34.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	},
	"packageManager": "pnpm@10.0.0+sha512.b8fef5494bd3fe4cbd4edabd0745df2ee5be3e4b0b8b08fa643aa3e4c6702ccc0f00d68fa8a8c9858a735a0032485a44990ed2810526c875e416f001b17df12b"
}
